# Salin file ini menjadi .env lalu isi dengan nilai asli Anda.
# JANGAN commit file .env asli ke GitHub!

TELEGRAM_BOT_TOKEN=isi_token_dari_botfather
PRODSELLER_API_KEY=psk_api_key_prodseller_anda
PRODSELLER_BASE_URL=https://prodseller.com/v1
PROXY_URL=

# ID Telegram admin (dapatkan dari @userinfobot)
ADMIN_ID=

# Harga jual per unit ke reseller (Rupiah)
PRICE_PER_UNIT=50000

# Path gambar QRIS statis
QRIS_IMAGE_PATH=qris.jpg

# Produk yang dijual (Product ID dari ProdSeller API)
PRODUCT_ID=6a31035939dc014325da2c66
PRODUCT_NAME=Gemini Pro 18 Months

# Username Telegram admin untuk menu Support (tanpa @)
SUPPORT_USERNAME=

# ================================================================
# PAKASIR (Payment Gateway QRIS)
# ================================================================
# Slug proyek dari dashboard Pakasir
PAKASIR_SLUG=
# API Key dari dashboard Pakasir
PAKASIR_API_KEY=
